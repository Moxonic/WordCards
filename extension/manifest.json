{
  "manifest_version": 3,
  "key": "",
  "name": "WordCards – Translate History Sync",
  "version": "0.1.0",
  "description": "Sends words you translate on Google Translate to your WordCards account for spaced-repetition review.",
  "permissions": ["identity", "storage", "alarms", "activeTab"],
  "host_permissions": [
    "https://translate.google.com/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "WordCards Sync" },
  "content_scripts": [
    {
      "matches": ["https://translate.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "438532077356-r45p3f15f35khscr6bkf8idcpvbkavv5.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  }
}

