rules_version = '2';

// Every user can read and write only their own subtree.
// The grading function writes `mistakes` and `meta/usage` with the Admin SDK,
// which bypasses these rules; the client only needs its own `writings` + reads.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
